# Copy this file to .env and edit.
# Must equal API_KEY in the ESP32 sketch (and the simulator's --key).
DEVICE_API_KEY=station-key-123

# SQLite file next to the backend folder. Later: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./juiceguard.db

# Default thresholds sent to every station (per-device overrides live in the DB).
DEFAULT_SAG_V=4.50
DEFAULT_OVER_VOLTAGE_V=5.50

# Current above this (mA) means a phone is drawing charge.
CHARGING_CURRENT_MA=50

# A station is considered offline if nothing arrived for this many seconds.
OFFLINE_AFTER_S=10
