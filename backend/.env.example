# Copy this file to .env and edit.
# Must equal API_KEY in the ESP32 sketch (and the simulator's --key).
DEVICE_API_KEY=station-key-123

# SQLite file next to the backend folder. Later: postgresql+psycopg://user:pass@host/db
DATABASE_URL=sqlite:///./juiceguard.db

# Default thresholds sent to every station (per-device overrides live in the DB).
DEFAULT_SAG_V=4.50
DEFAULT_OVER_VOLTAGE_V=5.50

# Current above this (mA) means a phone is drawing charge.
CHARGING_CURRENT_MA=50

# A station is considered offline if nothing arrived for this many seconds.
OFFLINE_AFTER_S=10

# ---- Portal logins ----
# Secret that signs login sessions. Make a long random one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty, the server generates one into backend/.jwt_secret.
JWT_SECRET=
# How long a login lasts (hours).
SESSION_HOURS=12
# true only when the site is served over HTTPS.
COOKIE_SECURE=false
# Wrong passwords allowed per email in the window before logins are blocked.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MIN=15
# Where the React portals run (comma separated).
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
